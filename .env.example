# Copy to .env and fill in. Never commit .env.

LOG_LEVEL=INFO

# Needed for extraction, the query-classifier fallback, the claim judge and
# synthesis -- unless every call is already in the LLM cache.
ANTHROPIC_API_KEY=

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphrag-lab-dev
NEO4J_DATABASE=neo4j

# Embeddings: "local" (sentence-transformers, no key) or "openai".
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Only for EMBEDDING_PROVIDER=openai:
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSION=1536

EXTRACTION_MODEL=claude-haiku-4-5-20251001
CLASSIFIER_MODEL=claude-haiku-4-5-20251001
SYNTHESIS_MODEL=claude-haiku-4-5-20251001
LLM_TEMPERATURE=0
LLM_CACHE_ENABLED=true
LLM_CACHE_DIR=.cache/llm

VECTOR_MERGE_THRESHOLD=0.92
VECTOR_CANDIDATE_THRESHOLD=0.80
