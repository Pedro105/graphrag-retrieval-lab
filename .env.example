# Copy to .env and fill in. Never commit .env.

LOG_LEVEL=INFO

# ANTHROPIC_API_KEY: extraction, query-classifier fallback, claim judge, synthesis.
# OPENAI_API_KEY: entity embeddings (text-embedding-3-small).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=

EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EXTRACTION_MODEL=claude-haiku-4-5-20251001
CLASSIFIER_MODEL=claude-haiku-4-5-20251001
SYNTHESIS_MODEL=claude-haiku-4-5-20251001
VECTOR_MERGE_THRESHOLD=0.92
VECTOR_CANDIDATE_THRESHOLD=0.80
